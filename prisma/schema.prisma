// ============================================================
// LUNARA — DATABASE SCHEMA (Prisma / PostgreSQL)
// Based on data/Lunara_Inventory_System_FINAL.xlsx and the BRD.
// This file is the shared contract between all three tracks —
// agree changes as a team before editing.
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum Category {
  EARRINGS
  RINGS
  BRACELETS
  NECKLACE
}

enum Finish {
  GOLD
  SILVER
}

// Stock is NEVER reserved.
//   COD:      placed → NEW (stock taken immediately — it's a sale)
//   JazzCash: placed → AWAITING_PAYMENT (no stock taken)
//             paid   → NEW (stock taken now), or CANCELLED + REFUND_NEEDED if it sold out meanwhile
//             unpaid for 24h → ABANDONED (nothing to give back)
// Then the owner moves NEW → PROCESSING → SHIPPED → DELIVERED. No owner "confirm" step.
enum OrderStatus {
  AWAITING_PAYMENT
  NEW
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  ABANDONED
}

enum PaymentMethod {
  COD
  JAZZCASH
}

enum PaymentStatus {
  UNPAID // COD until delivered, or JazzCash not yet paid
  PAID
  REFUND_NEEDED // paid, but the order can't be fulfilled — owner must refund
  REFUNDED
}

enum StockMovementReason {
  IMPORT // Excel importer set the quantity
  ADMIN_ADJUST // owner changed quantity in the admin panel
  SALE // COD order placed, or JazzCash payment confirmed
  ORDER_CANCELLED // stock returned because the order was cancelled
}

// ------------------------------------------------------------
// PRODUCT = one design (matches "Article No." in the spreadsheet)
// e.g. Earrings article 001 "Aveline pearl drop"
// ------------------------------------------------------------

model Product {
  id           Int      @id @default(autoincrement())
  category     Category
  articleNo    Int // unique per category, not globally (Rings 001 != Earrings 001)
  name         String
  slug         String   @unique // URL, e.g. "aveline-pearl-drop-ear-001"
  description  String?
  isActive     Boolean  @default(true) // hide the whole design without deleting history
  isNewArrival Boolean  @default(false) // owner picks what shows under "New Arrivals"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  variants Variant[]
  images   ProductImage[]

  @@unique([category, articleNo])
  @@index([isActive, category])
}

// ------------------------------------------------------------
// VARIANT = one stockable row (one row in the spreadsheet)
// e.g. Earrings 001 + Gold + Blue → SKU EAR-001-GD, qty 2
//
// The SKU is NOT unique: Gold+Blue and Gold+Green share EAR-001-GD.
// The real identity of a stock row is (product, finish, colour, size).
// `size` is "" (not NULL) for non-rings so the unique constraint
// actually blocks duplicates (Postgres treats NULLs as all different).
// ------------------------------------------------------------

model Variant {
  id        Int     @id @default(autoincrement())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  finish Finish
  colour String @default("None / Single") // sentinel from the Lists sheet = no colour choice
  size   String @default("") // rings only, e.g. "8" or "Adjustable"

  sku          String // generated: <CAT>-<articleNo>-<finishCode>, e.g. EAR-001-GD
  quantity     Int      @default(0) // never negative — enforced by a CHECK constraint in the migration
  costPrice    Decimal? @db.Decimal(10, 2)
  sellingPrice Decimal? @db.Decimal(10, 2) // null = not priced yet → hidden from the storefront
  isActive     Boolean  @default(true) // false = owner marked this variant sold out / hidden
  photoRef     String? // raw "Photo Ref." from the spreadsheet, kept for reference

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@unique([productId, finish, colour, size])
  @@index([sku])
}

// Stock status is NOT stored — compute it from `quantity` (see src/server):
//   0     → Out of Stock (option hidden on the storefront)
//   1–3   → "Only N left"
//   4+    → Available

// ------------------------------------------------------------
// PRODUCT IMAGE — photos belong to a design + finish + colour,
// so every ring size of the same colour shares the same photos.
// finish/colour null = general photo for the design.
// ------------------------------------------------------------

model ProductImage {
  id        Int     @id @default(autoincrement())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  finish    Finish?
  colour    String?
  url       String
  alt       String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@index([productId, finish, colour])
}

// ------------------------------------------------------------
// CUSTOMER (optional account — guest checkout also supported)
// ------------------------------------------------------------

model Customer {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  phone        String?
  passwordHash String? // null for guest-only customers
  createdAt    DateTime @default(now())

  orders Order[]
}

// ------------------------------------------------------------
// ORDER / ORDER ITEM
// Contact + shipping details are stored on every order (the BRD
// asks customers to enter them each time), account or guest.
// ------------------------------------------------------------

model Order {
  id          Int       @id @default(autoincrement())
  // customer-facing, e.g. "10001" — from a DB sequence created in the first migration
  orderNumber String    @unique @default(dbgenerated("(nextval('order_number_seq'::regclass))::text"))
  customer    Customer? @relation(fields: [customerId], references: [id])
  customerId  Int? // null for guest checkout

  customerName String
  email        String
  phone        String
  address      String
  city         String
  postalCode   String?

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(UNPAID)
  paymentRef    String? // JazzCash transaction reference
  paidAt        DateTime?
  status        OrderStatus

  // Set when this order's items were taken out of stock (COD: on placing,
  // JazzCash: on payment). Null = no stock to give back if it's cancelled.
  stockDeductedAt DateTime?

  subtotal    Decimal @db.Decimal(10, 2)
  shippingFee Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  cancelReason String?
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          OrderItem[]
  stockMovements StockMovement[]

  @@index([status, createdAt])
  @@index([paymentStatus])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  variant   Variant @relation(fields: [variantId], references: [id])
  variantId Int // the exact stock row, not just the SKU

  quantity Int

  // Snapshot at time of sale — order history stays correct even if the
  // product is renamed, repriced or deleted later.
  priceAtSale Decimal @db.Decimal(10, 2)
  productName String
  sku         String
  finish      Finish
  colour      String
  size        String
}

// ------------------------------------------------------------
// STOCK MOVEMENT — history of every quantity change, so the owner
// can see why stock went up or down.
// ------------------------------------------------------------

model StockMovement {
  id        Int     @id @default(autoincrement())
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId Int
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId   Int?

  change        Int // negative = stock out, positive = stock back in
  quantityAfter Int
  reason        StockMovementReason
  note          String?
  createdAt     DateTime            @default(now())

  @@index([variantId, createdAt])
}

// ------------------------------------------------------------
// ADMIN / MAILING LIST / SETTINGS
// ------------------------------------------------------------

model AdminUser {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String?
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Simple key/value store for owner-editable settings, e.g.
//   shipping_fee        → "250"
//   low_stock_threshold → "3"
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
