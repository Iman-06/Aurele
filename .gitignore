# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma generated client
/src/generated/

# locally stored product images (swapped for Cloudinary before launch)
/storage/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI / editor tool files (local only — CLAUDE.md and AGENTS.md are re-created by `next dev`)
/.claude/
/CLAUDE.md
/AGENTS.md
.neon
