# Copy this file to `.env` and fill in the real values (ask a teammate). `.env*` is git-ignored.
# ⚠️ This file IS committed: only placeholders here — never real passwords, keys or personal emails.

# ==========================================
# 1. Neon database (shared)
# ==========================================
# Pooled connection string (host contains `-pooler`) — used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct (unpooled) connection string — used by Prisma migrations (`npm run db:deploy`).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# LOCAL database used only by `npm test` — it gets wiped. Name must end in _test.
TEST_DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/aurele_test"

# ==========================================
# 2. Secrets (generate each with:
#    node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
# ==========================================
# Signs the admin login cookie.
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
# Sent to /api/cron/* as "Authorization: Bearer <CRON_SECRET>" (abandons unpaid orders).
CRON_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ==========================================
# 3. Resend (order emails — Track 3)
# ==========================================
RESEND_API_KEY="re_xxxxxxxx"
# Use onboarding@resend.dev until the shop's domain is verified in the Resend dashboard.
EMAIL_FROM="Aurelé <orders@theaurele.com>"
# Inbox that receives new-order alerts.
ORDER_NOTIFICATION_EMAIL="owner@example.com"

# ==========================================
# 4. Cloudinary (product + homepage photos — Track 2)
# ==========================================
# The shop's account (theaurele.co@gmail.com) → Settings → API Keys.
# Leave empty to save uploads on this computer only (storage/uploads).
# (CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>" works too.)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
