# ==========================================
# 1. Neon Database
# ==========================================
DATABASE_URL=""
DIRECT_URL=""

# Keeping this as you had it, in case your automated tests still rely on it
TEST_DATABASE_URL=""

# ==========================================
# 2. Authentication Secrets
# ==========================================
AUTH_SECRET=""
CRON_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ==========================================
# 3. Resend (Emails)
# ==========================================
# Using the API key you provided
RESEND_API_KEY=
# NOTE: Keep this as onboarding@resend.dev until you verify your actual domain (e.g., aurele.com) in the Resend dashboard.
EMAIL_FROM="Aurelé <orders@theaurele.com>"
# Put your real email here so you receive order notifications during testing
ORDER_NOTIFICATION_EMAIL="mominayasin369@gmail.com"

# ==========================================
# 4. Cloudinary (Media Uploads)
# ==========================================
# You MUST sign up at https://cloudinary.com to get these real values, 
# otherwise image uploads will fail.
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"