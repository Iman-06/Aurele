# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# Local PostgreSQL (installed on your machine). Format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/lunara"

# Separate database used only by the automated tests (it gets wiped).
TEST_DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/lunara_test"

# Secret used to sign the admin login session. Any long random string.
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
