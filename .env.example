# Copy this file to `.env` or `.env.local` and fill in real values. `.env*` is git-ignored.

# Database (Neon PostgreSQL)
# DATABASE_URL is the pooled connection string (host contains `-pooler`) used by Next.js runtime.
DATABASE_URL="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL is the direct unpooled connection string used for Prisma migrations.
DIRECT_URL="postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Separate database used only by automated tests (vitest wipes this DB before tests run).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aurele_test"

# Admin Authentication (Track 2)
# Long random string to sign jose JWT cookies for admin panel.
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# Cron Job Security (Track 2)
# Secret sent to /api/cron/* as "Authorization: Bearer <CRON_SECRET>" to abandon unpaid orders.
CRON_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# Email Delivery (Resend - Track 3)
# API key from resend.com
RESEND_API_KEY="re_sample_123456789"
# Verified sender domain address (e.g. orders@yourdomain.com)
EMAIL_FROM="orders@aurele.pk"
# Store owner's inbox for new incoming order alerts
ORDER_NOTIFICATION_EMAIL="owner@aurele.pk"

# Site Public URL (Track 3)
NEXT_PUBLIC_SITE_URL="https://www.aurele.pk"

# JazzCash Gateway (Track 3 - Phase 5)
JAZZCASH_MERCHANT_ID="MC12345"
JAZZCASH_PASSWORD="sample_password"
JAZZCASH_INTEGRITY_SALT="sample_salt"
JAZZCASH_ENV="sandbox"
JAZZCASH_RETURN_URL="https://www.aurele.pk/api/payments/jazzcash/return"
