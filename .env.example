# Copy this file to `.env` and fill in the real values (ask a teammate). `.env*` is git-ignored.
# ⚠️ This file IS committed: only placeholders here — never real passwords, keys or personal emails.
#
# "Needed in production?" means the live shop. Do not paste real values into this file.

# ==========================================
# 1. Neon database (shared, live)
# ==========================================
# Pooled connection string (host contains `-pooler`). The app uses this.
# Needed in production? Yes.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct (unpooled) connection string. Prisma migrations use this (`npm run db:deploy`).
# Needed in production? Yes, on the machine or host that applies migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ⚠️ TEST_DATABASE_URL must NEVER equal DATABASE_URL and must NEVER point at live data.
# `npm test` wipes this database. It must be a LOCAL database whose name ends in _test
# (localhost, 127.0.0.1, or ::1). The test setup refuses anything else, including Neon.
# Needed in production? No. Tests only.
TEST_DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/aurele_test"

# ==========================================
# 2. Secrets
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ==========================================
# Signs the admin login cookie and the order-confirmation link.
# Needed in production? Yes.
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# Bearer token for GET /api/cron/abandon-orders (unpaid JazzCash orders only).
# Needed in production? No, until JazzCash is live and the cron job is turned on.
CRON_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# Public site address. Used in order emails, robots.txt, sitemap.xml, and social tags.
# Needed in production? Yes. Example: https://www.aurele.pk
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Fallback support address when Settings has no support email. The returns page uses it.
# Needed in production? No. Prefer the support email in Admin → Settings.
NEXT_PUBLIC_SUPPORT_EMAIL=""

# ==========================================
# 3. Resend (order emails)
# ==========================================
# Sends the customer and owner emails after a Cash on Delivery order.
# Checkout still succeeds if this is empty; the email is skipped.
# Needed in production? Yes, if those emails should send.
RESEND_API_KEY="re_xxxxxxxx"

# From address. Must be a domain verified in Resend.
# Use onboarding@resend.dev until the shop domain is verified.
# If this is empty, the code falls back to orders@aurele.pk.
# Needed in production? Yes.
EMAIL_FROM="Aurele <orders@theaurele.com>"

# Shop inbox that receives the new-order email. If empty, that email is skipped.
# Needed in production? Yes, if the owner should be emailed.
ORDER_NOTIFICATION_EMAIL="owner@example.com"

# ==========================================
# 4. Cloudinary (product and homepage photos)
# ==========================================
# The shop's Cloudinary account → Settings → API Keys.
# Leave all three empty to save uploads on this computer only (storage/uploads).
# Those local photos do not survive on a hosted site.
# Needed in production? Yes.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional single-string substitute for the three values above.
# Form: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Needed in production? No, if the three values above are set.
# CLOUDINARY_URL=""

# ==========================================
# 5. Optional paths (laptop only)
# ==========================================
# Folder for photos saved when Cloudinary is not configured.
# Needed in production? No.
# MEDIA_DIR=""

# Folder where an Excel import preview is stored for up to 2 hours.
# A host with a read-only disk (such as Vercel) cannot use the default folder.
# Needed in production? No.
# IMPORT_DIR=""

# NODE_ENV is set by Next.js (development or production). Do not put it in .env.
